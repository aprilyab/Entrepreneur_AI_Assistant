# Required for business-plan generation and chat
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_API_KEYS=[]
GEMINI_MODEL=gemini-3.5-flash-lite

# Used by the backend. Docker Compose overrides the database host with `db`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/entrepreneur_ai
DATABASE_URL_ASYNC=postgresql+asyncpg://postgres:postgres@localhost:5432/entrepreneur_ai
SECRET_KEY=replace_with_a_long_random_secret
DEBUG=false

# Browser-facing backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
